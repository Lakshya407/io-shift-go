    {
      "id": "6b6371d4-0c80-5353-9701-4c59c4629f4a",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        20
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Non-secret deployment settings. Never paste credentials here.\nconst baseUrl = 'https://nightshift-cab-care.noblebuddy257.chatgpt.site';\nconst fromEmail = 'cab-alerts@YOUR-COMPANY.example';\nif (!/^https:\\/\\//.test(baseUrl) || /YOUR-CAB-APP/.test(baseUrl)) {\n  throw new Error('Set the HTTPS app URL in Configuration before activating this workflow.');\n}\nreturn [{json: {baseUrl: baseUrl.replace(/\\/$/, ''), fromEmail, limit: 5}}];"
      }
    },
    {
      "id": "d99180ce-2d68-563b-9783-4699e7b45c5d",
      "name": "Lease pending jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -440,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl + '/api/automation/jobs/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({limit: $json.limit, workerId: 'n8n-' + $execution.id}) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "CONFIGURE_CAB_APP_CUSTOM_AUTH",
          "name": "Cab app automation API"
        }
      }
    },
    {
      "id": "28766655-ef5b-59b4-9ec7-2c338eeaf9fb",
      "name": "Split claimed jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        20
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result = $input.first().json;\nif (!result || !Array.isArray(result.jobs)) {\n  throw new Error('Cab API returned an unexpected claim response; expected {jobs: []}.');\n}\nreturn result.jobs.map(job => ({json: job, pairedItem: {item: 0}}));"
      }
    },
    {
      "id": "03b0d73a-09e6-5fa2-a81c-58b7f978b3a7",
      "name": "Loop deliveries",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        40,
        20
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "56ab53c5-76cb-59df-b871-bbde2d993e20",
      "name": "Prepare delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $json;\nconst config = $('Configuration').first().json;\nif (!job.id || !job.leaseToken) throw new Error('Claimed job missing identity or lease token.');\nconst p = job.payload || {};\nlet validationError = '';\nif (!['teams', 'email'].includes(job.channel)) validationError = 'Unsupported notification channel.';\nelse if (typeof p.text !== 'string' || !p.text.trim()) validationError = 'Notification text is missing.';\nelse if (job.channel === 'teams' && (!p.teamId || !p.channelId)) validationError = 'Teams team or channel ID is missing.';\nelse if (job.channel === 'email' && (!Array.isArray(p.to) || p.to.length !== 1 || !/^[^\\s@,;]+@[^\\s@,;]+\\.[^\\s@,;]+$/.test(p.to[0]))) validationError = 'Email jobs require one valid recipient per job.';\nelse if (job.channel === 'email' && (/YOUR-COMPANY/.test(config.fromEmail) || !config.fromEmail.includes('@'))) validationError = 'Configure the workflow From email address.';\nelse if (job.channel === 'email' && (!p.subject || /[\\r\\n]/.test(p.subject))) validationError = 'Email subject is empty or contains a line break.';\nreturn {json: {...job, payload: p, validationError, fromEmail: config.fromEmail}};"
      }
    },
    {
      "id": "93acdbce-6c4b-5c31-89ed-7b12dc629a10",
      "name": "Valid job?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        20
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "89c06426-f539-5da9-a2d0-6d6da6d943ea",
              "leftValue": "={{ $json.validationError }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
