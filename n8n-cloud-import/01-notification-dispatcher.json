              "leftValue": "={{ $json.channel }}",
              "rightValue": "teams",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "73e2805a-b19d-51ef-a562-8dcb4846d068",
      "name": "Send Teams alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        -240
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.microsoft.com/v1.0/teams/' + encodeURIComponent($json.payload.teamId) + '/channels/' + encodeURIComponent($json.payload.channelId) + '/messages' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftTeamsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({body:{contentType:$json.payload.html ? 'html' : 'text',content:$json.payload.html || $json.payload.text},importance:$json.payload.priority === 'high' ? 'high' : 'normal'}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "CONFIGURE_MICROSOFT_TEAMS_OAUTH2",
          "name": "Cab admin Microsoft Teams"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "d3b2081a-9779-582a-9ba2-a693787ffc5c",
      "name": "Send email alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1020,
        0
      ],
      "parameters": {
        "fromEmail": "={{ $json.fromEmail }}",
        "toEmail": "={{ $json.payload.to.join(',') }}",
        "subject": "={{ $json.payload.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.payload.text }}",
        "html": "={{ $json.payload.html || ('<pre>' + $json.payload.text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</pre>') }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "CONFIGURE_CAB_ALERTS_SMTP",
          "name": "Cab alerts SMTP"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "108a4700-8f70-5256-b876-636474677941",
      "name": "Teams result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        -240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $('Prepare delivery').item.json;\nconst response = $json;\nconst body = response.body || {};\nconst ok = response.statusCode === 201 && Boolean(body.id) && !response.error;\nconst reason = response.error?.message || response.error || body.error?.message || `Teams returned HTTP ${response.statusCode || 'unknown'} without a created message ID.`;\nreturn {json: {id: job.id, leaseToken: job.leaseToken, status: ok ? 'sent' : 'failed',\n  providerId: ok ? String(body.id) : null,\n  error: ok ? null : String(reason).slice(0, 600)}};"
      }
    },
    {
      "id": "e9a45a6c-389d-5ba1-9c42-7f9b0a1f79a0",
      "name": "Email result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $('Prepare delivery').item.json;\nconst response = $json;\nconst addresses = values => Array.isArray(values) ? values.map(v => String(typeof v === 'string' ? v : v.address || '').toLowerCase()) : [];\nconst accepted = addresses(response.accepted);\nconst rejected = addresses(response.rejected);\nconst ok = !response.error && Boolean(response.messageId) && rejected.length === 0 && job.payload.to.every(a => accepted.includes(a.toLowerCase()));\nconst reason = response.error?.message || response.error || (rejected.length ? 'SMTP rejected the recipient.' : 'SMTP did not confirm acceptance for this recipient.');\nreturn {json: {id: job.id, leaseToken: job.leaseToken, status: ok ? 'sent' : 'failed',\n  providerId: ok ? String(response.messageId) : null,\n  error: ok ? null : String(reason).slice(0, 600)}};"
      }
    },
    {
      "id": "7cbdafaf-b47e-50fe-ad0d-78793b00de64",
      "name": "Invalid job result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {json: {id: $json.id, leaseToken: $json.leaseToken, status: 'failed', providerId: null, error: $json.validationError}};"
      }
    },
    {
      "id": "05e5c41e-6389-524d-ae98-ab88a7a6d50c",
      "name": "Record delivery result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.baseUrl + '/api/automation/jobs/' + encodeURIComponent($json.id) + '/receipt' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({leaseToken:$json.leaseToken,status:$json.status,providerId:$json.providerId,error:$json.error}) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "CONFIGURE_CAB_APP_CUSTOM_AUTH",
          "name": "Cab app automation API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "3b0e5262-5fc1-5471-8f10-c18a8ac0d8cf",
      "name": "Setup and delivery semantics",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -700,
        -540
      ],
      "parameters": {
        "content": "## Configure before publishing\n1. Set app URL and sender in Configuration.\n2. Select Cab API Custom Auth, Teams OAuth2, SMTP, and webhook Header Auth credentials.\n3. Set app N8N_WEBHOOK_URL + N8N_WEBHOOK_SECRET.\n4. Run supervised tests, then publish both workflows.\n\nApp database owns retries. Provider acceptance is not admin acknowledgment. An uncertain provider result can cause a duplicate on retry. See README.md.",
        "height": 300,
        "width": 600
      }
    },
    {
      "id": "67eb341a-eaa7-4aa5-be14-0dddcc9f9788",
      "name": "Setup status",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -960,
        -540
      ],
      "parameters": {
        "content": "## Connection setup \u2014 schedules are disabled\nThis copy is for supervised setup in the current n8n Cloud trial.\n\nThe app URL is configured. Bind the app API, webhook, Microsoft Teams and email credentials before testing delivery.\n\nThe original 30-second dispatcher and 1-minute maintenance schedules would start approximately 129,600 executions per 30 days. They are disabled here to prevent accidental consumption of the 1,000-execution trial.\n\nTimed recovery, SOS escalation and scheduled reports are NOT running. Agree an execution strategy and verify all credentials before enabling production schedules.",
        "height": 365,
        "width": 580
      }
    }
  ],
