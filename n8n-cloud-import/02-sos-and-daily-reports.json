    {
      "id": "6b6371d4-0c80-5353-9701-4c59c4629f4a",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Non-secret deployment settings. Never paste credentials here.\nconst baseUrl = 'https://nightshift-cab-care.noblebuddy257.chatgpt.site';\nconst fromEmail = 'cab-alerts@YOUR-COMPANY.example';\nif (!/^https:\\/\\//.test(baseUrl) || /YOUR-CAB-APP/.test(baseUrl)) {\n  throw new Error('Set the HTTPS app URL in Configuration before activating this workflow.');\n}\nreturn [{json: {baseUrl: baseUrl.replace(/\\/$/, ''), fromEmail, limit: 5}}];"
      }
    },
    {
      "id": "e63a32cc-9155-5673-b999-fdfb110034fb",
      "name": "Generate due reminders and reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl + '/api/automation/tick' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workerId:'n8n-maintenance-' + $execution.id}) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "CONFIGURE_CAB_APP_CUSTOM_AUTH",
          "name": "Cab app automation API"
        }
      }
    },
    {
      "id": "99dcaeec-a54c-500a-9bae-73c602f59091",
      "name": "How timing works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -180,
        -360
      ],
      "parameters": {
        "content": "## App-owned timing\nThe app decides which SOS reminders and daily reports are due, using the admin's settings and Asia/Kolkata by default. Tick is idempotent.\n\nThis workflow queues messages; the Notification Dispatcher sends them. No AI is used for routing or emergency decisions.\n\nConfigure the same app URL and Custom Auth credential as the dispatcher, then publish.",
        "height": 260,
        "width": 560
      }
    },
    {
      "id": "1c34cfdd-9b35-46db-a28d-7144ab37971b",
      "name": "Setup status",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -960,
        -540
      ],
      "parameters": {
        "content": "## Connection setup \u2014 schedules are disabled\nThis copy is for supervised setup in the current n8n Cloud trial.\n\nThe app URL is configured. Bind the app API, webhook, Microsoft Teams and email credentials before testing delivery.\n\nThe original 30-second dispatcher and 1-minute maintenance schedules would start approximately 129,600 executions per 30 days. They are disabled here to prevent accidental consumption of the 1,000-execution trial.\n\nTimed recovery, SOS escalation and scheduled reports are NOT running. Agree an execution strategy and verify all credentials before enabling production schedules.",
        "height": 365,
        "width": 580
      }
    }
  ],
