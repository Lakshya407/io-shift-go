# ShiftGo: runtime configuration template (safe to commit; no real values).
#   Docker Compose:  cp .env.example .env   and fill it in   (.env is git-ignored)
#   GitLab / Argo CD: add each key as a CI/CD variable or Kubernetes Secret/ConfigMap.
#                    Mark the [secret] ones Masked + Protected.
# None of these values are needed to BUILD or TEST the image. They are read only when
# the container starts, so a missing value never breaks the pipeline's build/test jobs.
# Generate random secrets with:  openssl rand -hex 32

# ---------- Public URL ----------
# [required] Public HTTPS URL, no trailing slash. Used for notification links and SSO.
SITE_URL=https://iocab.shiftgo.infoapps.io

# ---------- First administrator ----------
# [required, secret] Enter it once as the "Setup key" to create the first admin.
# Setup is disabled permanently after that.
SETUP_TOKEN=

# ---------- PostgreSQL ----------
# Used by the bundled postgres container (docker compose).
POSTGRES_USER=shiftgo
# [required with compose, secret] Use letters/digits only (it is embedded in a URL).
POSTGRES_PASSWORD=
POSTGRES_DB=shiftgo
# [secret] Full connection string. Leave empty with docker compose (built from the three
# values above, host "postgres"). Set it for Kubernetes or a managed database:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
# If empty and no compose default applies, the app falls back to a local SQLite file.
DATABASE_URL=
# require = TLS with certificate check, no-verify = TLS without the check, empty = as in DATABASE_URL.
DATABASE_SSL=
# Max connections per app instance (default 10).
# DATABASE_POOL_MAX=10

# ---------- Microsoft Entra ID (Azure AD) single sign-on ----------
# App registration > Authentication > platform "Web" > Redirect URI:
#   https://iocab.shiftgo.infoapps.io/api/auth/sso/callback
# All three must be set for the "Sign in with Microsoft" button to appear.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
# [secret]
AZURE_AD_CLIENT_SECRET=
# Optional. Defaults to <SITE_URL>/api/auth/sso/callback
AZURE_AD_REDIRECT_URI=https://iocab.shiftgo.infoapps.io/api/auth/sso/callback

# ---------- n8n automation (optional: Teams / email delivery) ----------
# [secret] at least 20 characters
AUTOMATION_API_KEY=
# e.g. http://n8n:5678/webhook/cab-notification-wakeup (compose --profile automation)
N8N_WEBHOOK_URL=
# [secret]
N8N_WEBHOOK_SECRET=

# ---------- Docker Compose host settings ----------
# Host port of the Nginx proxy.
SHIFTGO_HTTP_PORT=8088
