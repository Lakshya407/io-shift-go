# Copy to .dev.vars for local secrets (git-ignored). In production use:
#   npx wrangler secret put <NAME>
# Optional locally (setup is allowed from localhost). REQUIRED when deployed:
SETUP_TOKEN=
# Public URL used in notification links, e.g. https://cab.yourcompany.com
SITE_URL=
# Optional n8n integration (Teams/email delivery)
AUTOMATION_API_KEY=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Optional Microsoft Entra ID (Azure AD) SSO. Register this Redirect URI (platform: Web):
#   <SITE_URL>/api/auth/sso/callback   e.g. http://localhost:5173/api/auth/sso/callback
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Optional override if the public URL differs from SITE_URL / the request origin
AZURE_AD_REDIRECT_URI=
