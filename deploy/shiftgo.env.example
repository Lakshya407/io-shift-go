# Copy to /etc/shiftgo.env on the EC2 instance (owner root, chmod 600).
# Format: KEY=value, one per line, no spaces around "=". Never commit real values.
# After changing this file:  sudo systemctl restart shiftgo

# --- Server (keep as is when using the Nginx config in deploy/) ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/shiftgo/shiftgo.db
# Trust X-Forwarded-Proto / X-Real-IP from Nginx. Only safe because HOST=127.0.0.1.
VINEXT_TRUST_PROXY=1

# --- Required ---
# Public URL, used in notification links and SSO redirects.
SITE_URL=https://cab.yourcompany.com
# Long random string (openssl rand -hex 32). Enter it once as the "Setup key"
# to create the first administrator.
SETUP_TOKEN=

# --- Optional: n8n automation (Teams / email delivery) ---
AUTOMATION_API_KEY=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Optional: Microsoft Entra ID (Azure AD) single sign-on ---
# Redirect URI to register: <SITE_URL>/api/auth/sso/callback
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=

# --- Optional: copy the pre-deployment database backup to S3 ---
# The instance role needs s3:PutObject on this location.
BACKUP_S3_URI=
